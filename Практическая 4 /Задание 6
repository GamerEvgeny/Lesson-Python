import math

# Считываем угол в градусах (действительное число)
print('Введите действительное число Х в градусах.')
x = float(input())

# Переводим градусы в радианы
r = math.radians(x)

# Вычисляем значение тригонометрического выражения
result = math.sin(r) + math.cos(r) + math.tan(r) ** 2

# Выводим результат
print('Ответ:',result)
