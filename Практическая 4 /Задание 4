# Считываем количество школьников (n) и количество мандаринов (k)
print('Сколько студентов?')
n = int(input())
print('Сколько мандаринов?')
k = int(input())

# Вычисляем количество мандаринов на каждого школьника и остаток в корзине
per_student = k // n
in_basket = k % n

# Выводим оба числа, каждое на отдельной строке
print(per_student,'мандарина на каждого студента.')
print(in_basket,'мандарина останется в корзине.')
