import math

# Считываем координаты двух точек (четыре действительных числа)

x1, y1 = map(float, input("Введите координаты первой точки (х у):").split())
x2, y2 = map(float, input("Введите координаты второй точки (х у):").split())

# Вычисляем евклидово расстояние по формуле
distance = math.sqrt((x1 - y1) ** 2 + (x2 - y2) ** 2)

# Выводим результат
print(f"Расстояние между точками: {distance:.2f} см")
