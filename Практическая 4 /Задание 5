# Считываем общее количество минут
print ('Введите общее количество времени (в минутах).')
total_minutes = int(input())

# Вычисляем полное количество часов и оставшиеся минуты
hours = total_minutes // 60
minutes = total_minutes % 60

# Выводим результат строго в заданном формате
print(total_minutes, "минуты - это", hours, "час", minutes, "минут.")
